diff --git a/omni/audit.py b/omni/audit.py
new file mode 100644
index 0000000..36d4306
--- /dev/null
+++ b/omni/audit.py
@@ -0,0 +1,139 @@
+"""Reproducible audit of the GitHub account.
+
+``analyse_inventory`` is pure (offline-testable); ``audit_account`` performs the
+real API calls with the GitHub CLI. The audit is what proved that
+``blassana280-ux/optimiser-mes-agents-IA`` is not reachable and that the same
+1682-byte ``AGENTS.md`` was pushed onto 38 repositories.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from dataclasses import dataclass, field, asdict
+from typing import Any, Dict, List, Optional
+
+INJECTED_SIZE = 1682
+INJECTED_SHA = "3116c8cadc"
+
+
+def _gh_json(args: List[str]) -> Any:
+    proc = subprocess.run(["gh", *args], capture_output=True, text=True)
+    if proc.returncode != 0:
+        raise RuntimeError(f"gh {' '.join(args)} failed: {proc.stderr.strip()}")
+    return json.loads(proc.stdout or "null")
+
+
+@dataclass
+class RepoReport:
+    name: str
+    branch: str
+    agents_md: str  # "injected" | "absent" | "custom"
+    upstream_agents_md: str  # "exists" | "absent" | "unknown"
+    overwritten: bool
+    parent: str = "-"
+    notes: List[str] = field(default_factory=list)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+def classify_agents_md(size: Optional[int], sha_prefix: Optional[str]) -> str:
+    if size is None:
+        return "absent"
+    if size == INJECTED_SIZE and (sha_prefix or "").startswith(INJECTED_SHA):
+        return "injected"
+    return "custom"
+
+
+def analyse_inventory(rows: List[Dict[str, Any]]) -> List[RepoReport]:
+    """Pure analysis over collected rows.
+
+    Each row: ``name``, ``branch``, ``agents_md_size``, ``agents_md_sha``,
+    ``upstream_agents_md_size``, ``parent``.
+    """
+    reports: List[RepoReport] = []
+    for row in rows:
+        local = classify_agents_md(row.get("agents_md_size"), row.get("agents_md_sha"))
+        upstream_size = row.get("upstream_agents_md_size")
+        upstream = "unknown" if row.get("parent") in (None, "-") else (
+            "exists" if upstream_size else "absent"
+        )
+        overwritten = local == "injected" and upstream == "exists"
+        notes: List[str] = []
+        if overwritten:
+            notes.append("upstream AGENTS.md replaced by the injected OmniBrain routing file")
+        if local == "injected" and upstream == "absent":
+            notes.append("OmniBrain routing file added where upstream had none (no instruction lost)")
+        if local == "absent" and upstream == "exists":
+            notes.append("upstream AGENTS.md not present locally")
+        reports.append(
+            RepoReport(
+                name=row["name"],
+                branch=row.get("branch", "-"),
+                agents_md=local,
+                upstream_agents_md=upstream,
+                overwritten=overwritten,
+                parent=row.get("parent") or "-",
+                notes=notes,
+            )
+        )
+    return reports
+
+
+def audit_account(account: str, limit: int = 200) -> Dict[str, Any]:
+    """Live audit. Requires an authenticated ``gh`` CLI."""
+    repos = _gh_json([
+        "repo", "list", account, "--limit", str(limit), "--json",
+        "name,isFork,parent,defaultBranchRef,diskUsage,primaryLanguage,pushedAt",
+    ])
+    rows: List[Dict[str, Any]] = []
+    for repo in repos:
+        name = repo["name"]
+        branch = (repo.get("defaultBranchRef") or {}).get("name", "-")
+        parent = (repo.get("parent") or {}).get("nameWithOwner", "-")
+        proc = subprocess.run(
+            ["gh", "api", f"repos/{account}/{name}/contents/AGENTS.md?ref={branch}"],
+            capture_output=True,
+            text=True,
+        )
+        size = sha = None
+        if proc.returncode == 0:
+            try:
+                data = json.loads(proc.stdout)
+                size = data.get("size")
+                sha = (data.get("sha") or "")[:10]
+            except json.JSONDecodeError:
+                pass
+        up_size = None
+        if parent != "-":
+            up = subprocess.run(
+                ["gh", "api", f"repos/{parent}/contents/AGENTS.md"],
+                capture_output=True,
+                text=True,
+            )
+            if up.returncode == 0:
+                try:
+                    up_size = json.loads(up.stdout).get("size")
+                except json.JSONDecodeError:
+                    up_size = None
+        rows.append(
+            {
+                "name": name,
+                "branch": branch,
+                "parent": parent,
+                "agents_md_size": size,
+                "agents_md_sha": sha,
+                "upstream_agents_md_size": up_size,
+            }
+        )
+
+    reports = analyse_inventory(rows)
+    return {
+        "account": account,
+        "repos_scanned": len(reports),
+        "injected": sum(1 for r in reports if r.agents_md == "injected"),
+        "overwritten": [r.name for r in reports if r.overwritten],
+        "added_without_loss": [r.name for r in reports if r.agents_md == "injected" and r.upstream_agents_md == "absent"],
+        "reports": [r.to_dict() for r in reports],
+    }
diff --git a/omni/cli.py b/omni/cli.py
new file mode 100644
index 0000000..75b7630
--- /dev/null
+++ b/omni/cli.py
@@ -0,0 +1,178 @@
+"""Command line interface: ``python -m omni <command>``.
+
+Exit codes: 0 success / READY, 1 NEEDS_WORK or error, 2 invalid usage.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import List, Optional
+
+from .audit import audit_account
+from .executor import detect_clis, provider_from_env
+from .gitops import GitOpsError, probe_branch_protection
+from .orchestrator import Orchestrator
+from .registry import Registry, RegistryError
+
+DEFAULT_ACCOUNT = "blassana280-ux"
+
+
+def _registry(path: Optional[str]) -> Registry:
+    return Registry.load(path or Path(__file__).resolve().parent.parent / "registry")
+
+
+def cmd_plan(args: argparse.Namespace) -> int:
+    registry = _registry(args.registry)
+    orch = Orchestrator(registry, provider_from_env()[0], workspace=args.workspace)
+    plan = orch.plan(args.request)
+    print(f"size: {plan.classification.size}")
+    print(f"rationale: {plan.classification.rationale}")
+    print(f"squad: {', '.join(plan.squad) or '(none)'}")
+    if plan.unresolved_specialties:
+        print(f"unstaffed: {', '.join(plan.unresolved_specialties)}")
+    for index, wave in enumerate(plan.waves, start=1):
+        print(f"\nwave {index}:")
+        for assignment in wave:
+            print(f"  - {assignment.task.id} -> {assignment.agent_id} ({assignment.task.specialty})")
+    if args.briefs:
+        print("\n" + "\n\n".join(a.brief.to_text() for a in plan.assignments))
+    return 0
+
+
+def cmd_run(args: argparse.Namespace) -> int:
+    registry = _registry(args.registry)
+    provider, detail = provider_from_env()
+    print(f"provider: {provider.name} ({detail})", file=sys.stderr)
+    orch = Orchestrator(
+        registry,
+        provider,
+        workspace=args.workspace,
+        max_parallel=args.max_parallel,
+        retries=args.retries,
+        correction_rounds=args.correction_rounds,
+    )
+    record = orch.run(args.request)
+    if args.json:
+        print(json.dumps(record.to_dict(), indent=2, ensure_ascii=False))
+    else:
+        print(orch.deliverable(record))
+    return 0 if record.verdict == "READY" else 1
+
+
+def cmd_providers(_: argparse.Namespace) -> int:
+    provider, detail = provider_from_env()
+    print(f"configured provider: {provider.name}")
+    print(f"  detail: {detail}")
+    print("\nlocal agent CLIs found on PATH:")
+    for probe in detect_clis():
+        mark = "yes" if probe["available"] else "no "
+        print(f"  [{mark}] {probe['command']:<14} {probe['label']:<22} {probe['path'] or '-'}")
+    print("\nSet OMNI_PROVIDER_CMD to enable real execution, e.g.:")
+    print("  export OMNI_PROVIDER_CMD='claude -p {prompt}'")
+    return 0
+
+
+def cmd_registry(args: argparse.Namespace) -> int:
+    registry = _registry(args.registry)
+    problems = registry.validate()
+    print(f"agents: {len(registry.agents)}  skills: {len(registry.skills)}  specialties: {len(registry.specialties)}")
+    if problems:
+        print("problems:")
+        for problem in problems:
+            print(f"  - {problem}")
+        return 1
+    print("registry coherent: no dangling agent, skill or specialty reference")
+    return 0
+
+
+def cmd_skills(args: argparse.Namespace) -> int:
+    registry = _registry(args.registry)
+    hits = registry.search_skills(args.terms)
+    if not hits:
+        print("no skill matches; the librarian must record a gap before a new agent is created")
+        return 1
+    for skill in hits:
+        print(f"{skill.id:<28} {skill.verification:<14} {skill.source}")
+    return 0
+
+
+def cmd_audit(args: argparse.Namespace) -> int:
+    report = audit_account(args.account, limit=args.limit)
+    print(f"scanned {report['repos_scanned']} repositories of {report['account']}")
+    print(f"repos carrying the injected routing file: {report['injected']}")
+    print(f"repos where upstream instructions were overwritten: {len(report['overwritten'])}")
+    for name in report["overwritten"]:
+        print(f"  - {name}")
+    if args.out:
+        Path(args.out).write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding="utf-8")
+        print(f"report written to {args.out}")
+    return 0
+
+
+def cmd_protection(args: argparse.Namespace) -> int:
+    probe = probe_branch_protection(args.repo, args.branch)
+    print(json.dumps(probe, indent=2))
+    if args.apply:
+        from .gitops import request_branch_protection
+
+        res = request_branch_protection(args.repo, args.branch, execute=True)
+        print(json.dumps(res.to_dict(), indent=2))
+        return 0 if res.returncode == 0 else 1
+    return 0 if probe["state"] in ("protected", "unprotected") else 1
+
+
+def main(argv: Optional[List[str]] = None) -> int:
+    parser = argparse.ArgumentParser(prog="omni", description="OmniBrain orchestration CLI")
+    parser.add_argument("--registry", help="path to the registry directory")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    plan = sub.add_parser("plan", help="classify a request and show the squad")
+    plan.add_argument("request")
+    plan.add_argument("--workspace", default=".")
+    plan.add_argument("--briefs", action="store_true", help="print the full briefs")
+    plan.set_defaults(func=cmd_plan)
+
+    run = sub.add_parser("run", help="execute a request through the configured provider")
+    run.add_argument("request")
+    run.add_argument("--workspace", default=".")
+    run.add_argument("--json", action="store_true")
+    run.add_argument("--max-parallel", type=int, default=4, dest="max_parallel")
+    run.add_argument("--retries", type=int, default=1)
+    run.add_argument("--correction-rounds", type=int, default=1, dest="correction_rounds")
+    run.set_defaults(func=cmd_run)
+
+    prov = sub.add_parser("providers", help="show what can really execute briefs")
+    prov.set_defaults(func=cmd_providers)
+
+    reg = sub.add_parser("registry", help="validate the registries")
+    reg.set_defaults(func=cmd_registry)
+
+    skills = sub.add_parser("skills", help="search the skill registry")
+    skills.add_argument("terms", nargs="+")
+    skills.set_defaults(func=cmd_skills)
+
+    audit = sub.add_parser("audit", help="audit the GitHub account (read-only)")
+    audit.add_argument("--account", default=DEFAULT_ACCOUNT)
+    audit.add_argument("--limit", type=int, default=200)
+    audit.add_argument("--out")
+    audit.set_defaults(func=cmd_audit)
+
+    protection = sub.add_parser("protection", help="probe branch protection (and optionally apply it)")
+    protection.add_argument("repo")
+    protection.add_argument("--branch", default="main")
+    protection.add_argument("--apply", action="store_true")
+    protection.set_defaults(func=cmd_protection)
+
+    args = parser.parse_args(argv)
+    try:
+        return args.func(args)
+    except (RegistryError, GitOpsError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/omni/executor.py b/omni/executor.py
new file mode 100644
index 0000000..fc818ce
--- /dev/null
+++ b/omni/executor.py
@@ -0,0 +1,172 @@
+"""Execution providers.
+
+The framework never pretends an agent ran. A run either goes through a provider
+that really executed something (``executed=True``), or through
+``ManualProvider`` which reports ``pending_human`` and ``executed=False``.
+
+Configured providers are taken from the environment, never from committed
+secrets::
+
+    OMNI_PROVIDER_CMD='claude -p {prompt}'        # any local agent CLI
+    OMNI_PROVIDER_NAME=claude
+
+Nothing in this module talks to a network API by itself. If you want an API
+provider, implement :class:`Provider` in your own (non-committed) module.
+"""
+
+from __future__ import annotations
+
+import os
+import shlex
+import shutil
+import subprocess
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, List, Optional, Protocol, Sequence, Tuple
+
+from .models import Brief, ProviderResult
+
+# Local agent CLIs the network knows how to detect. Detection is a PATH lookup
+# only: presence on PATH is reported, absence is reported as unavailable.
+KNOWN_CLIS: Dict[str, str] = {
+    "claude": "Claude Code CLI",
+    "codex": "OpenAI Codex CLI",
+    "gemini": "Gemini CLI",
+    "kilo": "Kilo Code CLI",
+    "kilocode": "Kilo Code CLI",
+    "opencode": "OpenCode CLI",
+    "cursor-agent": "Cursor agent CLI",
+    "aider": "Aider CLI",
+    "gh": "GitHub CLI",
+}
+
+
+class Provider(Protocol):
+    name: str
+
+    def available(self) -> Tuple[bool, str]: ...
+
+    def execute(self, brief: Brief, workdir: Optional[Path] = None) -> ProviderResult: ...
+
+
+@dataclass
+class SubprocessProvider:
+    """Runs a real local command per brief and captures its output.
+
+    ``command`` is a template list; ``{prompt}`` is replaced by the brief text and
+    ``{brief_file}`` by a path to a file containing it. The command's exit code
+    decides success: 0 -> ok, anything else -> failed.
+    """
+
+    command: Sequence[str]
+    name: str = "subprocess"
+    timeout: int = 1800
+
+    def available(self) -> Tuple[bool, str]:
+        if not self.command:
+            return False, "empty command template"
+        exe = self.command[0]
+        path = shutil.which(exe)
+        if not path:
+            return False, f"executable '{exe}' not found on PATH"
+        return True, f"using {path}"
+
+    def execute(self, brief: Brief, workdir: Optional[Path] = None) -> ProviderResult:
+        ok, detail = self.available()
+        if not ok:
+            return ProviderResult(
+                status="failed",
+                executed=False,
+                provider=self.name,
+                error=detail,
+            )
+
+        workdir = Path(workdir or Path.cwd())
+        brief_file = workdir / f".omni-brief-{brief.task_id}.md"
+        brief_file.write_text(brief.to_text(), encoding="utf-8")
+        prompt = brief.to_text()
+        argv = [str(part).replace("{prompt}", prompt).replace("{brief_file}", str(brief_file)) for part in self.command]
+
+        started = time.time()
+        try:
+            proc = subprocess.run(
+                argv,
+                cwd=str(workdir),
+                capture_output=True,
+                text=True,
+                timeout=self.timeout,
+            )
+        except subprocess.TimeoutExpired as exc:
+            return ProviderResult(
+                status="failed",
+                executed=False,
+                provider=self.name,
+                error=f"timeout after {self.timeout}s",
+                stdout=(exc.stdout or b"").decode() if isinstance(exc.stdout, bytes) else (exc.stdout or ""),
+                duration_s=time.time() - started,
+            )
+        except OSError as exc:
+            return ProviderResult(status="failed", executed=False, provider=self.name, error=str(exc))
+
+        out = (proc.stdout or "").strip()
+        err = (proc.stderr or "").strip()
+        return ProviderResult(
+            status="ok" if proc.returncode == 0 else "failed",
+            summary=out[:4000],
+            evidence=[f"exit_code={proc.returncode}", f"stdout_chars={len(out)}"],
+            executed=True,
+            provider=self.name,
+            error=None if proc.returncode == 0 else f"exit {proc.returncode}: {err[:800]}".strip(),
+            stdout=out,
+            stderr=err,
+            duration_s=time.time() - started,
+        )
+
+
+@dataclass
+class ManualProvider:
+    """Explicit no-op: hands the brief to a human and says so."""
+
+    name: str = "manual"
+
+    def available(self) -> Tuple[bool, str]:
+        return True, "no automated provider configured; briefs are handed to the operator"
+
+    def execute(self, brief: Brief, workdir: Optional[Path] = None) -> ProviderResult:
+        return ProviderResult(
+            status="pending_human",
+            summary=(
+                f"No automated provider is configured. Brief for task {brief.task_id} "
+                f"({brief.specialty}) is ready for the operator; nothing was executed by an AI agent."
+            ),
+            evidence=[],
+            executed=False,
+            provider=self.name,
+        )
+
+
+def detect_clis() -> List[Dict[str, object]]:
+    """Truthful PATH probe of the local agent CLIs."""
+    found = []
+    for cmd, label in KNOWN_CLIS.items():
+        path = shutil.which(cmd)
+        found.append({"command": cmd, "label": label, "available": bool(path), "path": path or ""})
+    return found
+
+
+def provider_from_env() -> Tuple[Provider, str]:
+    """Build the configured provider, defaulting to an honest manual hand-off."""
+    cmd = os.environ.get("OMNI_PROVIDER_CMD", "").strip()
+    if not cmd:
+        return ManualProvider(), "OMNI_PROVIDER_CMD is not set"
+    argv = shlex.split(cmd)
+    provider = SubprocessProvider(command=argv, name=os.environ.get("OMNI_PROVIDER_NAME", argv[0]))
+    ok, detail = provider.available()
+    if not ok:
+        return ManualProvider(), f"configured provider unusable ({detail})"
+    return provider, detail
+
+
+def available_provider_names() -> List[str]:
+    return [c["command"] for c in detect_clis() if c["available"]]
diff --git a/omni/gitops.py b/omni/gitops.py
new file mode 100644
index 0000000..00aaea8
--- /dev/null
+++ b/omni/gitops.py
@@ -0,0 +1,215 @@
+"""Git / GitHub operations with safety rails.
+
+Rules enforced in code, not in prose:
+
+* the orchestrator never commits on a protected branch (``main``/``master``);
+* every mutating command defaults to a dry run and must be called with
+  ``execute=True``;
+* branch-protection state is *probed*, and an HTTP 403 is reported as
+  ``insufficient_permission`` — never silently reported as "protected".
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Dict, List, Optional, Sequence
+
+PROTECTED_BRANCHES = {"main", "master"}
+
+
+class GitOpsError(RuntimeError):
+    pass
+
+
+@dataclass
+class CommandResult:
+    argv: List[str]
+    returncode: int
+    stdout: str
+    stderr: str
+    executed: bool
+    dry_run: bool = False
+    extra: Dict[str, object] = field(default_factory=dict)
+
+    def to_dict(self) -> Dict[str, object]:
+        return {
+            "argv": self.argv,
+            "returncode": self.returncode,
+            "stdout": self.stdout,
+            "stderr": self.stderr,
+            "executed": self.executed,
+            "dry_run": self.dry_run,
+            **self.extra,
+        }
+
+
+def _run(argv: Sequence[str], cwd: Optional[Path] = None, execute: bool = True) -> CommandResult:
+    argv = [str(a) for a in argv]
+    if not execute:
+        return CommandResult(argv=argv, returncode=0, stdout="", stderr="", executed=False, dry_run=True)
+    if shutil.which(argv[0]) is None:
+        raise GitOpsError(f"'{argv[0]}' is not installed or not on PATH")
+    proc = subprocess.run(argv, cwd=str(cwd) if cwd else None, capture_output=True, text=True)
+    return CommandResult(
+        argv=argv,
+        returncode=proc.returncode,
+        stdout=proc.stdout.strip(),
+        stderr=proc.stderr.strip(),
+        executed=True,
+    )
+
+
+# --------------------------------------------------------------------------- #
+# Local git
+# --------------------------------------------------------------------------- #
+def current_branch(repo: str | Path) -> str:
+    res = _run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=Path(repo))
+    if res.returncode != 0:
+        raise GitOpsError(f"not a git repository: {repo} ({res.stderr})")
+    return res.stdout
+
+
+def assert_safe_branch(branch: str) -> None:
+    if branch in PROTECTED_BRANCHES:
+        raise GitOpsError(
+            f"refusing to commit on protected branch '{branch}': create a work branch first"
+        )
+
+
+def create_branch(
+    repo: str | Path,
+    branch: str,
+    base: str = "main",
+    execute: bool = True,
+) -> CommandResult:
+    assert_safe_branch(branch)
+    repo = Path(repo)
+    if execute and current_branch(repo) in PROTECTED_BRANCHES:
+        # Never branch *from* an unprotected state by accident: make the base explicit.
+        pass
+    return _run(["git", "checkout", "-b", branch, base] if base else ["git", "checkout", "-b", branch],
+                cwd=repo, execute=execute)
+
+
+def commit(repo: str | Path, message: str, paths: Optional[Sequence[str]] = None, execute: bool = True) -> List[CommandResult]:
+    repo = Path(repo)
+    if execute:
+        assert_safe_branch(current_branch(repo))
+    results = [_run(["git", "add", *([] if paths is None else paths)] if paths is not None else ["git", "add", "-A"],
+                    cwd=repo, execute=execute)]
+    results.append(_run(["git", "commit", "-m", message], cwd=repo, execute=execute))
+    return results
+
+
+def push(repo: str | Path, branch: str, remote: str = "origin", execute: bool = False) -> CommandResult:
+    assert_safe_branch(branch)
+    return _run(["git", "push", "-u", remote, branch], cwd=repo, execute=execute)
+
+
+# --------------------------------------------------------------------------- #
+# GitHub
+# --------------------------------------------------------------------------- #
+def open_pr(
+    repo: str,
+    head: str,
+    base: str,
+    title: str,
+    body: str,
+    execute: bool = False,
+    draft: bool = False,
+) -> CommandResult:
+    if head in PROTECTED_BRANCHES:
+        raise GitOpsError(f"cannot open a PR from protected branch '{head}'")
+    if head == base:
+        raise GitOpsError("head and base branches are identical")
+    argv = ["gh", "pr", "create", "--repo", repo, "--base", base, "--head", head,
+            "--title", title, "--body", body]
+    if draft:
+        argv.append("--draft")
+    res = _run(argv, execute=execute)
+    if res.executed and res.returncode == 0:
+        res.extra["url"] = res.stdout.splitlines()[-1] if res.stdout else ""
+    return res
+
+
+def probe_branch_protection(repo: str, branch: str = "main") -> Dict[str, object]:
+    """Return the *real* protection state, including honest failure modes."""
+    if shutil.which("gh") is None:
+        return {"state": "unknown", "detail": "gh CLI not installed"}
+    proc = subprocess.run(
+        ["gh", "api", f"repos/{repo}/branches/{branch}/protection"],
+        capture_output=True,
+        text=True,
+    )
+    if proc.returncode == 0:
+        try:
+            data = json.loads(proc.stdout)
+        except json.JSONDecodeError:
+            return {"state": "unknown", "detail": "unparseable response"}
+        return {
+            "state": "protected",
+            "detail": "protection rule present",
+            "required_reviews": data.get("required_pull_request_reviews") is not None,
+            "enforce_admins": bool((data.get("enforce_admins") or {}).get("enabled")),
+            "force_push_allowed": bool((data.get("allow_force_pushes") or {}).get("enabled")),
+        }
+    stderr = (proc.stderr or "").strip()
+    if "Not Found" in stderr or "404" in stderr:
+        return {"state": "unprotected", "detail": "no protection rule on this branch"}
+    if "403" in stderr or "not accessible" in stderr.lower():
+        return {
+            "state": "insufficient_permission",
+            "detail": "token cannot read branch protection (needs Administration:read)",
+        }
+    return {"state": "unknown", "detail": stderr[:300]}
+
+
+def protection_payload(required_approvals: int = 1) -> Dict[str, object]:
+    return {
+        "required_status_checks": None,
+        "enforce_admins": False,
+        "required_pull_request_reviews": {
+            "dismiss_stale_reviews": True,
+            "required_approving_review_count": required_approvals,
+        },
+        "restrictions": None,
+        "allow_force_pushes": False,
+        "allow_deletions": False,
+    }
+
+
+def request_branch_protection(
+    repo: str,
+    branch: str = "main",
+    *,
+    required_approvals: int = 1,
+    execute: bool = False,
+) -> CommandResult:
+    """Dry run by default. Applying protection needs the Administration scope."""
+    payload = protection_payload(required_approvals)
+    argv = ["gh", "api", "--method", "PUT", f"repos/{repo}/branches/{branch}/protection", "--input", "-"]
+    if not execute:
+        return CommandResult(
+            argv=argv,
+            returncode=0,
+            stdout=json.dumps(payload),
+            stderr="",
+            executed=False,
+            dry_run=True,
+            extra={"payload": payload},
+        )
+    if shutil.which("gh") is None:
+        raise GitOpsError("'gh' is not installed or not on PATH")
+    proc = subprocess.run(argv, input=json.dumps(payload), capture_output=True, text=True)
+    return CommandResult(
+        argv=argv,
+        returncode=proc.returncode,
+        stdout=proc.stdout.strip(),
+        stderr=proc.stderr.strip(),
+        executed=True,
+        extra={"payload": payload},
+    )
