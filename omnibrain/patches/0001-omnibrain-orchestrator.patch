+++ b/omni/memory.py
@@ -0,0 +1,127 @@
+"""Controlled shared memory.
+
+Design constraints:
+
+* an agent can always write to its own namespace inside a run;
+* writing to the *shared* namespace requires an explicit grant;
+* values are scanned for credential-looking strings and redacted before they are
+  ever persisted;
+* entries can expire (TTL) so a stale run cannot poison the network later.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import tempfile
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+SECRET_PATTERNS = [
+    re.compile(r"\bghp_[A-Za-z0-9]{20,}\b"),
+    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"),
+    re.compile(r"\bsk-[A-Za-z0-9\-_]{16,}\b"),
+    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
+    re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}\b"),
+    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S),
+    re.compile(r"(?i)\b(api[_-]?key|secret|token|password)\s*[:=]\s*[\"']?[^\s\"']{8,}"),
+]
+
+
+def redact(value: Any) -> Any:
+    """Recursively redact credential-looking strings."""
+    if isinstance(value, str):
+        out = value
+        for pattern in SECRET_PATTERNS:
+            out = pattern.sub("[REDACTED]", out)
+        return out
+    if isinstance(value, dict):
+        return {k: redact(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [redact(v) for v in value]
+    return value
+
+
+class MemoryDenied(PermissionError):
+    pass
+
+
+class SharedMemory:
+    """File-backed key/value store with per-agent ownership rules."""
+
+    def __init__(self, path: str | Path, run_id: str, writable_shared: Optional[List[str]] = None) -> None:
+        self.path = Path(path)
+        self.run_id = run_id
+        self.writable_shared = set(writable_shared or [])
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        if not self.path.exists():
+            self.path.write_text(json.dumps({"entries": {}}), encoding="utf-8")
+        self._lock_path = self.path.with_suffix(self.path.suffix + ".lock")
+
+    # ------------------------------------------------------------- plumbing
+    def _load(self) -> Dict[str, Any]:
+        try:
+            return json.loads(self.path.read_text(encoding="utf-8"))
+        except (json.JSONDecodeError, FileNotFoundError):
+            return {"entries": {}}
+
+    def _store(self, data: Dict[str, Any]) -> None:
+        fd, tmp = tempfile.mkstemp(dir=str(self.path.parent), prefix=".mem-")
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump(data, fh, ensure_ascii=False, indent=2)
+        os.replace(tmp, self.path)
+
+    @staticmethod
+    def _key(scope: str, key: str) -> str:
+        return f"{scope}::{key}"
+
+    # ---------------------------------------------------------------- write
+    def write(self, scope: str, key: str, value: Any, owner: str, ttl_s: Optional[int] = None) -> str:
+        if scope == "shared" and owner not in self.writable_shared:
+            raise MemoryDenied(f"agent '{owner}' is not granted writes to shared memory")
+        stamped = int(time.time()) + ttl_s if ttl_s else None
+        data = self._load()
+        data["entries"][self._key(scope, key)] = {
+            "value": redact(value),
+            "owner": owner,
+            "run_id": self.run_id,
+            "written_at": time.time(),
+            "expires_at": stamped,
+        }
+        self._store(data)
+        return self._key(scope, key)
+
+    # ----------------------------------------------------------------- read
+    def get(self, scope: str, key: str) -> Optional[Any]:
+        entry = self._load()["entries"].get(self._key(scope, key))
+        if not entry:
+            return None
+        if entry.get("expires_at") and entry["expires_at"] < time.time():
+            return None
+        return entry["value"]
+
+    def search(self, term: str, scope: Optional[str] = None) -> List[Dict[str, Any]]:
+        hits = []
+        now = time.time()
+        for full_key, entry in self._load()["entries"].items():
+            if scope and not full_key.startswith(f"{scope}::"):
+                continue
+            if entry.get("expires_at") and entry["expires_at"] < now:
+                continue
+            if term.lower() in json.dumps(entry["value"], ensure_ascii=False).lower():
+                hits.append({"key": full_key, **entry})
+        return hits
+
+    def purge_expired(self) -> int:
+        data = self._load()
+        now = time.time()
+        before = len(data["entries"])
+        data["entries"] = {
+            k: v
+            for k, v in data["entries"].items()
+            if not (v.get("expires_at") and v["expires_at"] < now)
+        }
+        self._store(data)
+        return before - len(data["entries"])
diff --git a/omni/messaging.py b/omni/messaging.py
new file mode 100644
index 0000000..df9b790
--- /dev/null
+++ b/omni/messaging.py
@@ -0,0 +1,77 @@
+"""Agent-to-agent messaging.
+
+A file-backed mailbox, scoped to a run. Messages are append-only JSONL so the
+conversation between agents is auditable after the fact. Unknown senders or
+recipients are rejected: the bus only carries traffic between declared agents.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from dataclasses import dataclass, asdict
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Set
+
+
+@dataclass
+class Message:
+    run_id: str
+    sender: str
+    recipient: str
+    subject: str
+    body: str
+    kind: str = "info"  # info | question | answer | correction | arbitration
+    payload: Optional[Dict[str, Any]] = None
+    ts: float = 0.0
+
+    def to_dict(self) -> Dict[str, Any]:
+        d = asdict(self)
+        d["ts"] = self.ts or time.time()
+        return d
+
+
+class UnknownAgent(LookupError):
+    pass
+
+
+class MessageBus:
+    def __init__(self, path: str | Path, run_id: str, known_agents: Set[str]) -> None:
+        self.path = Path(path)
+        self.run_id = run_id
+        self.known_agents = set(known_agents)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.path.touch(exist_ok=True)
+
+    def _validate(self, agent_id: str, role: str) -> None:
+        if agent_id not in self.known_agents:
+            raise UnknownAgent(f"{role} '{agent_id}' is not a declared agent")
+
+    def send(self, message: Message) -> Message:
+        self._validate(message.sender, "sender")
+        self._validate(message.recipient, "recipient")
+        if message.run_id != self.run_id:
+            raise ValueError("message run_id does not match the bus run")
+        message.ts = message.ts or time.time()
+        with self.path.open("a", encoding="utf-8") as fh:
+            fh.write(json.dumps(message.to_dict(), ensure_ascii=False) + "\n")
+        return message
+
+    def all(self) -> List[Dict[str, Any]]:
+        out: List[Dict[str, Any]] = []
+        for line in self.path.read_text(encoding="utf-8").splitlines():
+            line = line.strip()
+            if not line:
+                continue
+            msg = json.loads(line)
+            if msg.get("run_id") == self.run_id:
+                out.append(msg)
+        return out
+
+    def inbox(self, agent_id: str) -> List[Dict[str, Any]]:
+        self._validate(agent_id, "recipient")
+        return [m for m in self.all() if m["recipient"] == agent_id]
+
+    def outbox(self, agent_id: str) -> List[Dict[str, Any]]:
+        self._validate(agent_id, "sender")
+        return [m for m in self.all() if m["sender"] == agent_id]
diff --git a/omni/models.py b/omni/models.py
new file mode 100644
index 0000000..a01e1be
--- /dev/null
+++ b/omni/models.py
@@ -0,0 +1,291 @@
+"""Core data types for the OmniBrain network.
+
+Everything here is plain data so it can be serialised into the run trace and
+asserted on in tests. No behaviour lives in this module.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+import uuid
+from dataclasses import dataclass, field, asdict
+from typing import Any, Dict, List, Optional
+
+
+# --------------------------------------------------------------------------- #
+# Registry entities
+# --------------------------------------------------------------------------- #
+@dataclass(frozen=True)
+class Agent:
+    """A role profile, not a running program.
+
+    An agent profile says *what* should be done, by which tools it is allowed to
+    do it, and where the knowledge came from. Actual execution always requires
+    an explicit :class:`omni.executor.Provider`.
+    """
+
+    id: str
+    title: str
+    specialties: List[str]
+    skills: List[str]
+    provenance: str
+    boundaries: List[str] = field(default_factory=list)
+    brief_template: str = ""
+
+    @staticmethod
+    def from_dict(d: Dict[str, Any]) -> "Agent":
+        return Agent(
+            id=d["id"],
+            title=d["title"],
+            specialties=list(d.get("specialties", [])),
+            skills=list(d.get("skills", [])),
+            provenance=d.get("provenance", ""),
+            boundaries=list(d.get("boundaries", [])),
+            brief_template=d.get("brief_template", ""),
+        )
+
+
+@dataclass(frozen=True)
+class Skill:
+    id: str
+    title: str
+    source: str
+    specialties: List[str]
+    verification: str  # "repo-exists" | "path-verified" | "unverified"
+    notes: str = ""
+
+    @staticmethod
+    def from_dict(d: Dict[str, Any]) -> "Skill":
+        return Skill(
+            id=d["id"],
+            title=d["title"],
+            source=d["source"],
+            specialties=list(d.get("specialties", [])),
+            verification=d.get("verification", "unverified"),
+            notes=d.get("notes", ""),
+        )
+
+
+# --------------------------------------------------------------------------- #
+# Planning
+# --------------------------------------------------------------------------- #
+@dataclass
+class Task:
+    id: str
+    specialty: str
+    title: str
+    objective: str
+    acceptance_criteria: List[str] = field(default_factory=list)
+    depends_on: List[str] = field(default_factory=list)
+
+
+@dataclass
+class Brief:
+    """Self-contained instructions handed to one agent in one wave."""
+
+    task_id: str
+    agent_id: str
+    specialty: str
+    objective: str
+    acceptance_criteria: List[str]
+    allowed_tools: List[str]
+    boundaries: List[str]
+    context: Dict[str, Any] = field(default_factory=dict)
+    attempt: int = 1
+    correction_of: Optional[str] = None
+    missing_criteria: List[str] = field(default_factory=list)
+
+    def to_text(self) -> str:
+        lines = [
+            f"# Task {self.task_id} -> agent {self.agent_id} (attempt {self.attempt})",
+            f"Specialty: {self.specialty}",
+            "",
+            "## Objective",
+            self.objective,
+            "",
+            "## Acceptance criteria",
+        ]
+        lines += [f"- {c}" for c in self.acceptance_criteria] or ["- (none declared)"]
+        lines += ["", "## Allowed tools"]
+        lines += [f"- {t}" for t in self.allowed_tools] or ["- (none)"]
+        if self.boundaries:
+            lines += ["", "## Boundaries (do not cross)"]
+            lines += [f"- {b}" for b in self.boundaries]
+        if self.correction_of:
+            lines += [
+                "",
+                "## Correction requested",
+                f"Previous attempt {self.correction_of} was incomplete.",
+                "Missing criteria: " + ", ".join(self.missing_criteria or ["(unspecified)"]),
+            ]
+        if self.context:
+            lines += ["", "## Shared context", json.dumps(self.context, indent=2, ensure_ascii=False)]
+        return "\n".join(lines)
+
+
+@dataclass
+class Assignment:
+    task: Task
+    agent_id: str
+    wave: int
+    brief: Brief
+
+
+@dataclass
+class Classification:
+    size: str  # simple | medium | complex
+    scores: Dict[str, float]
+    specialties: List[str]
+    rationale: str
+
+    @property
+    def squad_size(self) -> int:
+        return max(1, len(self.specialties))
+
+
+@dataclass
+class Plan:
+    request: str
+    classification: Classification
+    tasks: List[Task]
+    assignments: List[Assignment]
+    squad: List[str]
+    unresolved_specialties: List[str] = field(default_factory=list)
+
+    @property
+    def waves(self) -> List[List[Assignment]]:
+        out: Dict[int, List[Assignment]] = {}
+        for a in self.assignments:
+            out.setdefault(a.wave, []).append(a)
+        return [out[k] for k in sorted(out)]
+
+
+# --------------------------------------------------------------------------- #
+# Execution
+# --------------------------------------------------------------------------- #
+@dataclass
+class ProviderResult:
+    status: str = "failed"  # ok | failed | incomplete | pending_human
+    summary: str = ""
+    evidence: List[str] = field(default_factory=list)
+    artifacts: List[str] = field(default_factory=list)
+    met_criteria: List[str] = field(default_factory=list)
+    claims: Dict[str, Any] = field(default_factory=dict)
+    executed: bool = False
+    provider: str = "none"
+    error: Optional[str] = None
+    stdout: str = ""
+    stderr: str = ""
+    duration_s: float = 0.0
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+@dataclass
+class Result:
+    task_id: str
+    agent_id: str
+    status: str
+    summary: str
+    evidence: List[str]
+    artifacts: List[str]
+    met_criteria: List[str]
+    claims: Dict[str, Any]
+    executed: bool
+    provider: str
+    attempt: int = 1
+    error: Optional[str] = None
+    duration_s: float = 0.0
+    reassigned_from: Optional[str] = None
+
+    @classmethod
+    def from_provider(cls, brief: Brief, pr: ProviderResult, reassigned_from: Optional[str] = None) -> "Result":
+        return cls(
+            task_id=brief.task_id,
+            agent_id=brief.agent_id,
+            status=pr.status,
+            summary=pr.summary,
+            evidence=list(pr.evidence),
+            artifacts=list(pr.artifacts),
+            met_criteria=list(pr.met_criteria),
+            claims=dict(pr.claims),
+            executed=pr.executed,
+            provider=pr.provider,
+            attempt=brief.attempt,
+            error=pr.error,
+            duration_s=pr.duration_s,
+            reassigned_from=reassigned_from,
+        )
+
+
+@dataclass
+class Correction:
+    task_id: str
+    agent_id: str
+    missing_criteria: List[str]
+    round: int
+
+
+@dataclass
+class Arbitration:
+    topic: str
+    values: Dict[str, Any]
+    winner_agent: str
+    winner_task: str
+    rule: str
+    resolved: bool = True
+
+
+@dataclass
+class GateFinding:
+    gate: str
+    passed: bool
+    detail: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+@dataclass
+class RunRecord:
+    request: str
+    run_id: str = field(default_factory=lambda: uuid.uuid4().hex[:12])
+    size: str = ""
+    specialties: List[str] = field(default_factory=list)
+    squad: List[str] = field(default_factory=list)
+    results: List[Result] = field(default_factory=list)
+    corrections: List[Correction] = field(default_factory=list)
+    arbitrations: List[Arbitration] = field(default_factory=list)
+    findings: List[GateFinding] = field(default_factory=list)
+    unresolved_specialties: List[str] = field(default_factory=list)
+    verdict: str = "NEEDS_WORK"
+    started_at: float = field(default_factory=time.time)
+    finished_at: Optional[float] = None
+    trace: List[Dict[str, Any]] = field(default_factory=list)
+
+    def by_task(self) -> Dict[str, Result]:
+        """Latest result per task."""
+        out: Dict[str, Result] = {}
+        for r in self.results:
+            out[r.task_id] = r
+        return out
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "run_id": self.run_id,
+            "request": self.request,
+            "size": self.size,
+            "specialties": self.specialties,
+            "squad": self.squad,
+            "verdict": self.verdict,
+            "unresolved_specialties": self.unresolved_specialties,
+            "results": [asdict(r) for r in self.results],
+            "corrections": [asdict(c) for c in self.corrections],
+            "arbitrations": [asdict(a) for a in self.arbitrations],
+            "findings": [f.to_dict() for f in self.findings],
+            "started_at": self.started_at,
+            "finished_at": self.finished_at,
+            "duration_s": (self.finished_at or self.started_at) - self.started_at,
+        }
diff --git a/omni/orchestrator.py b/omni/orchestrator.py
new file mode 100644
index 0000000..16fe337
--- /dev/null
+++ b/omni/orchestrator.py
@@ -0,0 +1,479 @@
+"""The OmniBrain orchestrator.
+
+Flow: classify -> plan -> parallel waves -> failure handling -> correction loop
+-> arbitration -> validation gates -> single verdict + trace.
+
+Threads are real: a wave is executed with :class:`ThreadPoolExecutor`, and the
+measured wall time is recorded so parallelism is observable, not claimed.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence
+
+from .executor import ManualProvider, Provider
+from .memory import SharedMemory
+from .messaging import Message, MessageBus
+from .models import (
+    Arbitration,
+    Assignment,
+    Brief,
+    Classification,
+    Correction,
+    Plan,
+    ProviderResult,
+    Result,
+    RunRecord,
+    Task,
+)
+from .policy import Policy
+from .registry import Registry
+from .routing import Router
+from .trace import Trace
+from .validation import ValidationEngine, verdict_for
+
+OMNIBRAIN = "omnibrain"
+
+
+class Orchestrator:
+    def __init__(
+        self,
+        registry: Registry,
+        provider: Optional[Provider] = None,
+        *,
+        workspace: str | Path = ".",
+        state_dir: Optional[str | Path] = None,
+        max_parallel: int = 4,
+        retries: int = 1,
+        correction_rounds: int = 1,
+        require_execution: bool = True,
+    ) -> None:
+        self.registry = registry
+        self.provider = provider or ManualProvider()
+        self.policy = Policy(registry.permissions)
+        self.router = Router(registry, self.policy)
+        self.workspace = Path(workspace)
+        self.state_dir = Path(state_dir or self.workspace / ".omni")
+        self.max_parallel = max_parallel
+        self.retries = retries
+        self.correction_rounds = correction_rounds
+        self.validator = ValidationEngine(require_execution=require_execution)
+
+    # ------------------------------------------------------------------ plan
+    def plan(self, request: str) -> Plan:
+        return self.router.plan(request)
+
+    def classify(self, request: str) -> Classification:
+        return self.router.classify(request)
+
+    # ------------------------------------------------------------------- run
+    def run(self, request: str, plan: Optional[Plan] = None) -> RunRecord:
+        record = RunRecord(request=request)
+        plan = plan or self.plan(request)
+        trace = Trace(record.run_id, self.state_dir / "runs" / f"{record.run_id}.jsonl")
+        memory = SharedMemory(self.state_dir / "memory.json", record.run_id, writable_shared=[OMNIBRAIN])
+        bus = MessageBus(self.state_dir / "bus.jsonl", record.run_id, set(self.registry.agents) | {OMNIBRAIN})
+
+        record.size = plan.classification.size
+        record.specialties = list(plan.classification.specialties)
+        record.squad = list(plan.squad)
+        record.unresolved_specialties = list(plan.unresolved_specialties)
+        trace.emit(
+            "plan",
+            size=record.size,
+            specialties=record.specialties,
+            squad=record.squad,
+            rationale=plan.classification.rationale,
+            waves=len(plan.waves),
+            unresolved=record.unresolved_specialties,
+        )
+        for sid in plan.unresolved_specialties:
+            trace.emit("missing_specialty", specialty=sid)
+
+        # ---------------------------------------------------------- waves
+        for index, wave in enumerate(plan.waves, start=1):
+            started = time.time()
+            results = self._run_wave(wave, trace)
+            wall = round(time.time() - started, 4)
+            record.results.extend(results)
+            trace.emit(
+                "wave",
+                wave=index,
+                size=len(wave),
+                wall_s=wall,
+                serial_s=round(sum(r.duration_s for r in results), 4),
+                tasks=[r.task_id for r in results],
+                executed=[r.executed for r in results],
+            )
+            self._handle_failures(wave, results, record, trace, bus, memory)
+
+        # ---------------------------------------------------- corrections
+        self._correction_loop(plan, record, trace, bus, memory)
+
+        # ---------------------------------------------------- arbitration
+        record.arbitrations = self._arbitrate(record, trace)
+
+        # --------------------------------------------------------- gates
+        record.findings = self.validator.check(record, plan, trace)
+        record.verdict = verdict_for(record.findings)
+        record.finished_at = time.time()
+
+        trace.emit(
+            "verdict",
+            verdict=record.verdict,
+            failed_gates=[f.gate for f in record.findings if not f.passed],
+        )
+        record.trace = trace.events
+
+        memory.write(
+            "shared",
+            f"verdict:{record.run_id}",
+            {
+                "request": request,
+                "verdict": record.verdict,
+                "squad": record.squad,
+                "failed_gates": [f.gate for f in record.findings if not f.passed],
+            },
+            owner=OMNIBRAIN,
+        )
+        self._persist(record)
+        return record
+
+    # -------------------------------------------------------------- internals
+    def _run_wave(self, wave: Sequence[Assignment], trace: Trace) -> List[Result]:
+        workers = max(1, min(self.max_parallel, len(wave)))
+        if workers == 1:
+            return [self._dispatch(a, trace) for a in wave]
+        with ThreadPoolExecutor(max_workers=workers, thread_name_prefix="omni") as pool:
+            futures = [pool.submit(self._dispatch, a, trace) for a in wave]
+            return [f.result() for f in futures]
+
+    def _dispatch(
+        self,
+        assignment: Assignment,
+        trace: Trace,
+        *,
+        attempt: int = 1,
+        agent_id: Optional[str] = None,
+        missing: Optional[List[str]] = None,
+        reassigned_from: Optional[str] = None,
+    ) -> Result:
+        agent_id = agent_id or assignment.agent_id
+        agent = self.registry.agents[agent_id]
+        task = assignment.task
+        brief = Brief(
+            task_id=task.id,
+            agent_id=agent_id,
+            specialty=task.specialty,
+            objective=task.objective,
+            acceptance_criteria=task.acceptance_criteria,
+            allowed_tools=self.policy.allowed_tools(agent_id),
+            boundaries=agent.boundaries,
+            context={"request": assignment.brief.context.get("request", ""), "specialty": task.specialty},
+            attempt=attempt,
+            correction_of=task.id if missing else None,
+            missing_criteria=list(missing or []),
+        )
+
+        decision = self.policy.check(agent_id, "execute_task")
+        trace.emit(
+            "policy",
+            agent=agent_id,
+            action="execute_task",
+            allowed=decision.allowed,
+            reason=decision.reason,
+        )
+        trace.emit(
+            "dispatch",
+            task=task.id,
+            agent=agent_id,
+            specialty=task.specialty,
+            attempt=attempt,
+            wave=assignment.wave,
+            tools=brief.allowed_tools,
+            provider=getattr(self.provider, "name", "unknown"),
+        )
+        if not decision.allowed:
+            result = Result(
+                task_id=task.id,
+                agent_id=agent_id,
+                status="failed",
+                summary="",
+                evidence=[],
+                artifacts=[],
+                met_criteria=[],
+                claims={},
+                executed=False,
+                provider="none",
+                attempt=attempt,
+                error=decision.reason,
+                reassigned_from=reassigned_from,
+            )
+            trace.emit("result", task=task.id, agent=agent_id, status="failed", executed=False, error=decision.reason)
+            return result
+
+        started = time.time()
+        try:
+            provider_result = self.provider.execute(brief, self.workspace)
+        except Exception as exc:  # a provider crash must not kill the run
+            provider_result = ProviderResult(
+                status="failed",
+                error=f"{type(exc).__name__}: {exc}",
+                provider=getattr(self.provider, "name", "unknown"),
+                executed=False,
+                duration_s=time.time() - started,
+            )
+
+        result = Result.from_provider(brief, provider_result, reassigned_from=reassigned_from)
+        # measure it ourselves: a provider's self-reported duration is not evidence
+        result.duration_s = round(time.time() - started, 4)
+        trace.emit(
+            "result",
+            task=task.id,
+            agent=agent_id,
+            status=result.status,
+            executed=result.executed,
+            provider=result.provider,
+            evidence=len(result.evidence),
+            met=result.met_criteria,
+        )
+        return result
+
+    def _handle_failures(
+        self,
+        wave: Sequence[Assignment],
+        results: List[Result],
+        record: RunRecord,
+        trace: Trace,
+        bus: MessageBus,
+        memory: SharedMemory,
+    ) -> None:
+        by_task = {a.task.id: a for a in wave}
+        for result in list(results):
+            if result.status not in ("failed",):
+                continue
+            assignment = by_task[result.task_id]
+
+            # 1. retry with the same agent
+            for attempt in range(2, self.retries + 2):
+                trace.emit("retry", task=result.task_id, agent=result.agent_id, attempt=attempt)
+                retried = self._dispatch(assignment, trace, attempt=attempt)
+                record.results.append(retried)
+                result = retried
+                if retried.status != "failed":
+                    break
+            if result.status != "failed":
+                continue
+
+            # 2. reassign to a fallback agent for that specialty
+            fallbacks = self.registry.fallbacks(assignment.task.specialty, exclude=[result.agent_id])
+            if fallbacks:
+                fallback = fallbacks[0]
+                trace.emit(
+                    "reassign",
+                    task=result.task_id,
+                    from_agent=result.agent_id,
+                    to_agent=fallback,
+                    specialty=assignment.task.specialty,
+                )
+                bus.send(
+                    Message(
+                        run_id=record.run_id,
+                        sender=OMNIBRAIN,
+                        recipient=fallback,
+                        subject=f"takeover {result.task_id}",
+                        body=f"Agent {result.agent_id} failed on {assignment.task.title}: {result.error or result.status}",
+                        kind="correction",
+                        payload={"task": result.task_id, "missing": []},
+                    )
+                )
+                reassigned = self._dispatch(
+                    assignment,
+                    trace,
+                    agent_id=fallback,
+                    attempt=result.attempt + 1,
+                    reassigned_from=result.agent_id,
+                )
+                record.results.append(reassigned)
+                if reassigned.status != "failed":
+                    memory.write(
+                        "shared",
+                        f"reassign:{result.task_id}",
+                        {"from": result.agent_id, "to": fallback, "status": reassigned.status},
+                        owner=OMNIBRAIN,
+                    )
+                    continue
+                result = reassigned
+
+            # 3. escalate: no fallback worked
+            trace.emit("escalate", task=result.task_id, agent=result.agent_id, reason="no fallback agent succeeded")
+            bus.send(
+                Message(
+                    run_id=record.run_id,
+                    sender=OMNIBRAIN,
+                    recipient=record.squad[0] if record.squad else list(self.registry.agents)[0],
+                    subject=f"escalation {result.task_id}",
+                    body="All agents and fallbacks failed; human arbitration required.",
+                    kind="question",
+                )
+            )
+
+    def _correction_loop(
+        self,
+        plan: Plan,
+        record: RunRecord,
+        trace: Trace,
+        bus: MessageBus,
+        memory: SharedMemory,
+    ) -> None:
+        for round_no in range(1, self.correction_rounds + 1):
+            latest = record.by_task()
+            pending: List[tuple[Task, Assignment, List[str]]] = []
+            for assignment in plan.assignments:
+                task = assignment.task
+                result = latest.get(task.id)
+                if result is None or result.status == "failed":
+                    continue
+                unmet = [c for c in task.acceptance_criteria if c not in result.met_criteria]
+                if result.status != "ok" or unmet:
+                    pending.append((task, assignment, unmet))
+            if not pending:
+                return
+            for task, assignment, unmet in pending:
+                agent_id = latest[task.id].agent_id
+                record.corrections.append(
+                    Correction(task_id=task.id, agent_id=agent_id, missing_criteria=unmet, round=round_no)
+                )
+                trace.emit("correction_request", task=task.id, agent=agent_id, missing=unmet, round=round_no)
+                bus.send(
+                    Message(
+                        run_id=record.run_id,
+                        sender=OMNIBRAIN,
+                        recipient=agent_id,
+                        subject=f"correction {task.id} round {round_no}",
+                        body="Deliverable incomplete. Missing: " + (", ".join(unmet) or "no acceptance criteria met"),
+                        kind="correction",
+                        payload={"missing": unmet, "round": round_no},
+                    )
+                )
+                corrected = self._dispatch(
+                    assignment,
+                    trace,
+                    attempt=latest[task.id].attempt + 1,
+                    agent_id=agent_id,
+                    missing=unmet,
+                )
+                record.results.append(corrected)
+                memory.write(
+                    "run",
+                    f"correction:{task.id}:r{round_no}",
+                    {"agent": agent_id, "missing": unmet, "status": corrected.status},
+                    owner=OMNIBRAIN,
+                )
+
+    # ---------------------------------------------------------- arbitration
+    def _arbitrate(self, record: RunRecord, trace: Trace) -> List[Arbitration]:
+        latest = record.by_task()
+        topics: Dict[str, Dict[str, Any]] = {}
+        for result in latest.values():
+            for topic, value in result.claims.items():
+                topics.setdefault(topic, {})[result.task_id] = value
+
+        arbitrations: List[Arbitration] = []
+        for topic, per_task in topics.items():
+            distinct = {json.dumps(v, sort_keys=True, default=str) for v in per_task.values()}
+            if len(distinct) <= 1:
+                continue
+            ranked = sorted(
+                per_task.items(),
+                key=lambda kv: (
+                    -len(latest[kv[0]].evidence),
+                    not latest[kv[0]].executed,
+                    -len(latest[kv[0]].met_criteria),
+                    kv[0],
+                ),
+            )
+            (win_task, _), (run_task, _) = ranked[0], ranked[1]
+            w = latest[win_task]
+            r = latest[run_task]
+            tie = (
+                len(w.evidence) == len(r.evidence)
+                and w.executed == r.executed
+                and len(w.met_criteria) == len(r.met_criteria)
+            )
+            arbitration = Arbitration(
+                topic=topic,
+                values=per_task,
+                winner_agent=w.agent_id,
+                winner_task=win_task,
+                rule="evidence_count > execution > criteria_met > task_id" if not tie else "unresolved tie",
+                resolved=not tie,
+            )
+            arbitrations.append(arbitration)
+            trace.emit(
+                "arbitration",
+                topic=topic,
+                winner=w.agent_id,
+                winner_task=win_task,
+                resolved=arbitration.resolved,
+                rule=arbitration.rule,
+                values=per_task,
+            )
+        return arbitrations
+
+    # ------------------------------------------------------------ persistence
+    def _persist(self, record: RunRecord) -> None:
+        out = self.state_dir / "runs" / f"{record.run_id}.json"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(record.to_dict(), indent=2, ensure_ascii=False), encoding="utf-8")
+
+    def deliverable(self, record: RunRecord) -> str:
+        """Assemble one coherent document from all results."""
+        lines = [
+            f"# OmniBrain run {record.run_id}",
+            "",
+            f"**Request:** {record.request}",
+            f"**Classification:** {record.size} — {', '.join(record.specialties)}",
+            f"**Squad:** {', '.join(record.squad) or '(none)'}",
+            f"**Verdict:** {record.verdict}",
+            "",
+        ]
+        if record.unresolved_specialties:
+            lines += [f"**Unstaffed specialties:** {', '.join(record.unresolved_specialties)}", ""]
+        lines.append("## Deliverables")
+        latest = record.by_task()
+        for task_id in latest:
+            r = latest[task_id]
+            lines += [
+                f"### {task_id} — {r.agent_id}",
+                f"- status: `{r.status}` (executed by provider: {r.executed}, `{r.provider}`)",
+                r.summary or "_(no summary)_",
+            ]
+            if r.error:
+                lines.append(f"- error: {r.error}")
+            if r.evidence:
+                lines.append("- evidence: " + "; ".join(r.evidence))
+            if r.artifacts:
+                lines.append("- artifacts: " + ", ".join(r.artifacts))
+            lines.append("")
+        if record.corrections:
+            lines.append("## Corrections requested")
+            lines += [
+                f"- {c.task_id} → {c.agent_id} (round {c.round}): missing {c.missing_criteria or 'criteria'}"
+                for c in record.corrections
+            ]
+            lines.append("")
+        if record.arbitrations:
+            lines.append("## Arbitrations")
+            lines += [
+                f"- {a.topic}: kept `{a.winner_agent}` ({a.rule}); resolved={a.resolved}"
+                for a in record.arbitrations
+            ]
+            lines.append("")
+        lines.append("## Gates")
+        lines += [f"- {f.gate}: {'PASS' if f.passed else 'FAIL'} — {f.detail}" for f in record.findings]
+        return "\n".join(lines)
